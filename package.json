{
  "name": "notion-terminal-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated remote MCP server exposing terminal and filesystem tools to Notion Custom Agents.",
  "main": "dist-desktop/main/index.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:server && npm run build:electron && npm run build:renderer",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "app:dev": "concurrently -k -n \"vite,electron\" -c \"cyan,magenta\" \"vite\" \"electron .\"",
    "app:start": "npm run build && electron .",
    "package:exe": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ngrok/ngrok": "^1.7.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "puppeteer-core": "^25.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^8.2.2"
  }
}
