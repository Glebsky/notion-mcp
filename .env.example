# Generate with: npm run token
MCP_API_KEY=replace-with-at-least-32-random-characters
PORT=3000
HOST=127.0.0.1

# Semicolon-separated allowed Host headers when listening publicly.
# Example: mcp.example.com;localhost:3000
ALLOWED_HOSTS=localhost:3000;127.0.0.1:3000
# The active provider adds only its exact hostname for this session.

# none | ngrok | tuna | cloudflare | localtunnel
# If absent/empty, legacy NGROK_ENABLED=true selects ngrok.
TUNNEL_PROVIDER=none

# Install CLIs separately; empty executable paths use PATH. No auto-downloads.
TUNA_EXECUTABLE=
TUNA_API_KEY=
TUNA_SUBDOMAIN=
CLOUDFLARED_EXECUTABLE=
# quick: temporary, no SSE; named: configure a routed hostname in Cloudflare.
CLOUDFLARE_MODE=quick
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_URL=
LOCALTUNNEL_EXECUTABLE=
LOCALTUNNEL_SUBDOMAIN=

# Ngrok tunnel configuration
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Full filesystem access is disabled unless this is explicitly set to true.
FULL_ACCESS=false

# Used only while FULL_ACCESS=false.
FILES_ROOT=./workspace

COMMAND_TIMEOUT_MS=120000
MAX_OUTPUT_BYTES=1048576
MAX_FILE_BYTES=10485760

